---
import '../styles/global.css';

const { title = 'Bookmarklet Exporter', description = 'Bookmarklets to share as drag links and javascript: URLs.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja" class="no-js" data-base={import.meta.env.BASE_URL || '/'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="page no-js">
    <main>
      <slot />
    </main>
  </body>
</html>
